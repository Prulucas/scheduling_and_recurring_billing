# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Encryption keys for LGPD (generate with: python -c "from apps.accounts.encryption import generate_encryption_key; print(generate_encryption_key())")
ENCRYPTION_KEY=
HMAC_KEY=

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Payment Gateway (mock | stripe | asaas | mercadopago)
PAYMENT_GATEWAY=mock
